# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# claude code — 개인 로컬 설정 및 설치된 도구 (공유 불필요)
.claude/

# impeccable(디자인 도구)이 만드는 임시 기록 — 공유할 내용이 아닙니다
.impeccable/

# 참고용 원본 문서 (개최계획안 등)
# ⚠️ 예산·심판 수당·리스크 분석 등 대외 공개용이 아닌 내용이 들어 있습니다.
#    저장소에 넣지 않고 공용 구글 드라이브에 보관하세요.
#    사이트에 실을 내용은 config/competition.ts 로 옮겨 적습니다.
add_context/

# 머리띠 배경 원본 (저작권 표시 불필요한 사진)
# 사이트가 쓰는 것은 public/header/ 의 줄인 JPEG 입니다.
# ★ 원본은 이 컴퓨터에만 있습니다. 공용 구글 드라이브에도 올려 두세요. ★
header_images/

# 첫 화면 배경 후보 원본 사진 (한 장에 10MB, 합계 34MB)
# 저장소에는 public/hero/ 의 '줄인 사진'만 넣습니다.
# ★ 원본은 이 컴퓨터에만 있습니다. 공용 구글 드라이브에도 올려 두세요. ★
background_images/

# typescript
*.tsbuildinfo
next-env.d.ts

# 종목 로고 원본 (ROBOFEST 본부 제공)
# 사이트가 쓰는 것은 public/categories/ 의 줄인 PNG 입니다.
# ⚠️ 폴더 이름의 'catgories' 는 오타지만, 실제 폴더 이름이 그렇습니다.
# ★ 원본은 이 컴퓨터에만 있습니다. 공용 구글 드라이브에도 올려 두세요. ★
catgories image/

# 검토 의견 슬라이드 (종목 카드 디자인 피드백)
# ⚠️ 따옴표를 붙이지 마세요. .gitignore 에서는 따옴표도 글자로 취급되어
#    이름에 따옴표가 든 폴더를 찾게 됩니다. 빈칸은 그냥 두면 됩니다.
categories reference/
