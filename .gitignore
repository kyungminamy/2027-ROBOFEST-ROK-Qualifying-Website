# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# claude code — 개인 로컬 설정 및 설치된 도구 (공유 불필요)
.claude/

# impeccable(디자인 도구)이 만드는 임시 기록 — 공유할 내용이 아닙니다
.impeccable/

# 첫 화면 배경 후보 원본 사진 (한 장에 10MB, 합계 34MB)
# 저장소에는 public/hero/ 의 '줄인 사진'만 넣습니다.
# ★ 원본은 이 컴퓨터에만 있습니다. 공용 구글 드라이브에도 올려 두세요. ★
background_images/

# typescript
*.tsbuildinfo
next-env.d.ts
