# ============================================================================
#  줄바꿈 문자 통일 설정
#
#  【 이 파일이 필요한 이유 】
#   윈도우와 맥은 줄바꿈을 다르게 저장합니다 (윈도우 CRLF / 맥·리눅스 LF).
#   이 설정이 없으면, github.com 에서 날짜 한 줄만 고쳐도
#   '파일 전체가 바뀐 것'으로 표시되어 무엇을 고쳤는지 확인할 수 없습니다.
#
#   아래 설정은 저장소에 항상 LF로 저장하도록 강제합니다.
#   각자 컴퓨터에서는 평소처럼 편집하면 되고, 신경 쓸 것이 없습니다.
#
#  ★ 이 파일은 수정할 필요가 없습니다. ★
# ============================================================================

# 기본값: 텍스트 파일은 저장소에 LF로 저장
* text=auto eol=lf

# ----------------------------------------------------------------------------
#  바이너리 파일 — 줄바꿈 변환을 하면 파일이 깨집니다. 절대 건드리지 마세요.
# ----------------------------------------------------------------------------
*.woff2 binary
*.woff  binary
*.ttf   binary
*.otf   binary
*.ico   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.pdf   binary

# SVG는 텍스트지만 diff가 읽을 만한 형태가 아니므로 표시만 해 둡니다
*.svg -diff

# ----------------------------------------------------------------------------
#  윈도우에서만 쓰는 파일은 CRLF를 유지해야 정상 동작합니다
# ----------------------------------------------------------------------------
*.bat text eol=crlf
*.cmd text eol=crlf
